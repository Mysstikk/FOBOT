<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="FOBOT">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import FOBOT urdf file -->
    <xacro:include filename="$(find robot_pkg)/urdf/robot.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="FOBOT.ros2_control.xacro" />


    <xacro:FOBOT_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
